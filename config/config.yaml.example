# Source groups/channels list (to monitor)
# Supported formats:
# - Group ID (negative number): -100123456789
# - Channel username: @channel_name
# - Private chat username: @username
source_chats:
  - -100123456789  # Example group ID
  # - "@example_channel"  # Example channel

# Target groups/channels (where to forward messages)
# Can contain group IDs, channel usernames, or private chat usernames
target_chats:
  - -100987654321

# UI language configuration
# en_US: English (default)
# zh_CN: Chinese
language: en_US

# Chat and group metadata export
export:
  # Must be persistent in Docker; the default is covered by the existing data volume.
  root_dir: data/exports
  timezone: Asia/Shanghai
  # Range: 1-4. Telegram rate limits still apply when multiple jobs run.
  concurrency: 2

# Persistent real-time forwarding queue
forward_queue:
  # Keep this path under data/ so Docker restarts preserve pending messages.
  db_path: data/forward_queue.db
  # Non-rate-limit errors use bounded exponential retries.
  max_retries: 5
  retry_base_seconds: 5
  # Extra safety margin added to Telegram's requested FloodWait duration.
  flood_wait_buffer: 1
  poll_interval: 1
  # Merge separate Telegram updates belonging to the same media album.
  media_group_settle_seconds: 1
  # Completed tombstones prevent duplicate updates from being re-enqueued.
  completed_retention_days: 7

# Message callback-button handling (Telegram User mode only)
# Rules are independent from forwarding rules. Each incoming message is
# handled at most once.
button_action_rules:
  - name: Example confirmation
    enabled: false
    source_chats:
      - "@example_bot"
    button_texts:
      - "Confirm"
      - "^Claim .* reward$"
    # exact | contains | regex
    match_mode: exact
    # Click every matching callback button in message order (default: first only)
    click_all_matches: false
    # Wait after receiving the message before clicking (0-30 seconds)
    delay: 0

# Message filtering rules
filters:
  # Regex pattern list (any match passes)
  # Leave empty to disable regex filtering
  regex_patterns:
    - "\\[Important\\].*"
    - "Alert.*"

  # Keyword list (any match passes)
  # Leave empty to disable keyword filtering
  keywords:
    - "keyword1"
    - "keyword2"

  # Filter mode: whitelist or blacklist
  # whitelist: Only forward messages matching the rules
  # blacklist: Forward all messages except those matching the rules
  mode: whitelist

# Forwarding options
forwarding:
  # Whether to preserve original format (forward instead of copy)
  preserve_format: true

  # Whether to add source information
  add_source_info: true

  # Forwarding delay (seconds) to avoid rate limits
  delay: 0.5

# Ignore list (higher priority than filter rules)
ignore:
  # List of user IDs to ignore
  # Format: numeric ID, can be obtained via @userinfobot
  user_ids: []
    # - 123456789
    # - 987654321

  # List of keywords to ignore
  # Messages containing any keyword will be ignored
  keywords: []
    # - "advertisement"
    # - "promotion"
