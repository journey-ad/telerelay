# Telegram API credentials
# Get from https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash

# Proxy configuration (optional)
# Supported protocols: socks5, http
# Example: socks5://127.0.0.1:1080 or http://127.0.0.1:1080
PROXY_URL=

# Web service configuration
WEB_HOST=0.0.0.0
WEB_PORT=8080

# WebApp URL for Telegram Mini App
# Set to the public HTTPS URL of your WebUI, e.g., https://your-domain.com:8080
# This enables opening the control console directly inside Telegram as a Mini App
WEBAPP_URL=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Web authentication (HTTP Basic Auth)
# Leave empty to disable authentication
WEB_AUTH_USERNAME=
WEB_AUTH_PASSWORD=

# Runtime language: zh_CN (Chinese) or en_US (English)
LANGUAGE=en_US

# Admin Bot Token (for managing the forwarder via Telegram commands)
# Get from @BotFather, must be a DIFFERENT bot from the forwarding bot
ADMIN_BOT_TOKEN=

# Admin Chat ID (only this user/chat can use management commands)
# Get your chat ID from @userinfobot
ADMIN_CHAT_ID=
